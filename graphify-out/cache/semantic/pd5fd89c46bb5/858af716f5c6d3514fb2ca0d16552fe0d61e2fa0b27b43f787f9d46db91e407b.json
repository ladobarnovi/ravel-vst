{"nodes": [{"id": "_github_workflows_build_macos_build_macos", "label": "build-macos CI job", "file_type": "code", "source_file": ".github/workflows/build-macos.yml", "source_location": "jobs.build-macos", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no Mac in the development loop, so the macOS VST3/AU is cross-built on a macos-14 GitHub Actions runner. Manual trigger only (workflow_dispatch)."}, {"id": "_github_workflows_build_macos_juce_tag", "label": "JUCE_TAG pin (9.0.1)", "file_type": "rationale", "source_file": ".github/workflows/build-macos.yml", "source_location": "env.JUCE_TAG", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JUCE is not committed to the repo (.gitignore), so CI clones it. The tag is pinned to the same version the Windows build is developed against so a local build and a CI build are the same build."}, {"id": "_github_workflows_build_macos_universal_binary", "label": "Universal binary configure (arm64 + x86_64)", "file_type": "rationale", "source_file": ".github/workflows/build-macos.yml", "source_location": "steps: Configure (universal binary)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CMAKE_OSX_ARCHITECTURES=\"arm64;x86_64\" with deployment target 11.0 so one artifact runs on both Apple Silicon and Intel Macs; tests are switched off in CI."}, {"id": "_github_workflows_build_macos_artifact_upload", "label": "Bundle artifact upload path convention", "file_type": "rationale", "source_file": ".github/workflows/build-macos.yml", "source_location": "steps: Upload VST3 / Upload AU", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The path points at the bundle's parent folder, not the .vst3/.component itself: upload-artifact treats a given directory as the root, so pointing at the bundle would upload its Contents/ loose and drop the bundle name."}], "edges": [{"source": "_github_workflows_build_macos_build_macos", "target": "cmakelists_ravel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/build-macos.yml", "source_location": "steps: Configure / Build Release", "weight": 1.0}, {"source": "_github_workflows_build_macos_build_macos", "target": "cmakelists_ravel_build_tests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/build-macos.yml", "source_location": "-DRAVEL_BUILD_TESTS=OFF", "weight": 1.0}, {"source": "_github_workflows_build_macos_universal_binary", "target": "_github_workflows_build_macos_build_macos", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/build-macos.yml", "source_location": "steps: Configure (universal binary)", "weight": 1.0}, {"source": "_github_workflows_build_macos_juce_tag", "target": "_github_workflows_build_macos_build_macos", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/build-macos.yml", "source_location": "env.JUCE_TAG", "weight": 1.0}, {"source": "_github_workflows_build_macos_artifact_upload", "target": "_github_workflows_build_macos_build_macos", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/build-macos.yml", "source_location": "steps: Upload VST3 / Upload AU", "weight": 1.0}, {"source": "_github_workflows_build_macos_build_macos", "target": "cmakelists_per_format_bundle_ids", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".github/workflows/build-macos.yml", "source_location": "Xcode generator, macos-14 runner", "weight": 1.0}], "hyperedges": []}